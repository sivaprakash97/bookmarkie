{
  "name": "bookmarkie",
  "private": true,
  "version": "0.1.0",
  "description": "All your Chrome, X, LinkedIn and Instagram bookmarks in one searchable place",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
