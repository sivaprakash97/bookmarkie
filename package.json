{
  "name": "bookmarkie",
  "private": true,
  "version": "0.1.0",
  "description": "All your Chrome, X, LinkedIn and Instagram bookmarks in one searchable place",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare && node scripts/prepare-assets.mjs",
    "test:e2e": "BOOKMARKIE_E2E=1 wxt build && playwright test",
    "prebuild": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "chrono-node": "^2.9.0",
    "dexie": "^4.2.0",
    "minisearch": "^7.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@wxt-dev/module-react": "^1.1.3",
    "fake-indexeddb": "^6.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wxt": "^0.20.11"
  }
}
